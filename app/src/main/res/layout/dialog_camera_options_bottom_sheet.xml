<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/app_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="@string/profile_picture"
        android:textColor="@color/text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_take_photo"
        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical|start"
        android:paddingHorizontal="16dp"
        android:text="@string/option_take_photo"
        android:textColor="@color/text_primary"
        app:icon="@drawable/ic_camera"
        app:iconTint="@color/text_primary"
        app:strokeColor="@color/outline_color" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_option_remove_photo"
        style="@style/Widget.Material3.Button.OutlinedButton.Icon"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical|start"
        android:paddingHorizontal="16dp"
        android:text="@string/option_remove_photo"
        android:textColor="@color/accent_coral"
        app:icon="@drawable/ic_trash"
        app:iconTint="@color/accent_coral"
        app:strokeColor="@color/outline_color" />

</LinearLayout>